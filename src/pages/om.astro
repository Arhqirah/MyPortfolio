---
import { Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { about, seeking } from '../data/site.js';
import portrait from '../assets/work/SimonMelbyeAndersen.jpg';

const mailto = `mailto:simonmelbyeandersen@gmail.com?subject=${encodeURIComponent(
  seeking.mailSubject,
)}`;
---

<Base
  title="Om"
  description="Webudvikler-studerende på EK, tidligere multimediedesigner fra KEA. Søger praktikplads som webudvikler 18. januar–31. marts 2027."
>
  <section class="edge om">
    <p class="label" data-reveal>Om</p>

    <div class="intro">
      <h1 class="lead" data-reveal style="--rd:60ms">{about.lead}</h1>
      <div class="portrait" data-reveal style="--rd:90ms">
        <Picture
          src={portrait}
          alt="Simon Melbye Andersen"
          formats={['avif', 'webp']}
          fallbackFormat="webp"
          quality={72}
          widths={[320, 480, 640]}
          sizes="(min-width: 860px) 18rem, 60vw"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </div>
    </div>

    <div class="seek" data-reveal style="--rd:140ms">
      <div>
        <p class="label">Søger</p>
        <p class="seek-role">{seeking.role}</p>
        <p class="label">{seeking.period} · {seeking.location}</p>
      </div>
      <a class="btn press" href={mailto}>Skriv om praktik →</a>
    </div>

    <div class="cols">
      <div class="prose">
        {about.body.map((p, i) => (
          <p data-reveal style={`--rd:${i * 40}ms`}>{p}</p>
        ))}
      </div>

      <aside class="side">
        <div data-reveal>
          <p class="label">Baggrund</p>
          <ul class="cv">
            {about.cv.map((c) => (
              <li>
                <span class="role">{c.role}</span>
                <span class="place">{c.place}</span>
              </li>
            ))}
          </ul>
        </div>
      </aside>
    </div>

    <div class="skills" data-reveal style="--rd:70ms">
      <p class="label">Kan</p>
      <div class="skill-grid">
        {about.skills.map((group) => (
          <div class="skill-group">
            <p class="group-label">{group.group}</p>
            <ul class="chips">
              {group.items.map((item) => <li>{item}</li>)}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
  .om {
    position: relative;
    padding-block: clamp(3rem, 9vh, 6rem) var(--sect);
  }

  .intro {
    display: grid;
    gap: clamp(1.75rem, 5vw, 3rem);
    align-items: start;
    margin: 1.5rem 0 clamp(2.5rem, 7vh, 4rem);
  }
  @media (min-width: 860px) {
    .intro {
      grid-template-columns: 1fr 17rem;
    }
  }

  .lead {
    margin: 0;
    max-width: 24ch;
    font-size: var(--fs-h1);
  }

  .portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    max-width: 17rem;
    overflow: hidden;
    background: var(--paper-2);
    border-top: 3px solid var(--signal);
  }
  .portrait :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 32%;
  }

  .seek {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: clamp(3rem, 9vh, 5.5rem);
    padding: 1.5rem;
    border: 1px solid var(--line);
    border-top: 3px solid var(--signal);
  }
  .seek-role {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: clamp(1.3rem, 2.4vw, 1.9rem);
    letter-spacing: -0.02em;
    margin: 0.35rem 0;
  }
  .seek .btn {
    display: inline-block;
    padding: 0.75rem 1.15rem;
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    box-shadow: var(--glow);
    white-space: nowrap;
  }

  .cols {
    display: grid;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  @media (min-width: 860px) {
    .cols {
      grid-template-columns: 1fr 18rem;
    }
  }

  .prose {
    display: grid;
    gap: 1.2rem;
    max-width: 60ch;
    font-size: 1.12rem;
    line-height: 1.6;
  }

  .side {
    display: grid;
    gap: 2.5rem;
    align-content: start;
  }

  .cv {
    list-style: none;
    margin: 1rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.85rem;
  }
  .cv li {
    display: grid;
    gap: 0.15rem;
    border-top: 1px solid var(--line);
    padding-top: 0.6rem;
  }
  .cv .place {
    color: var(--muted);
    font-size: 0.95rem;
  }

  .skills {
    margin-top: clamp(3rem, 8vh, 5.5rem);
    padding-top: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--line);
  }

  .skill-grid {
    margin-top: clamp(1.5rem, 4vh, 2.25rem);
    display: grid;
    gap: clamp(1.75rem, 4vw, 2.75rem);
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
  }

  .group-label {
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--signal);
  }

  .chips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }
  .chips li {
    padding: 0.35rem 0.6rem;
    border: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }

</style>
