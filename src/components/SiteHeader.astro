---
import { nav } from '../data/site.js';
import ColorBar from './ColorBar.astro';

const path = Astro.url.pathname;
const isCurrent = (href) => path === href || path.startsWith(href + '/');
---

<header class="site-header">
  <div class="edge row">
    <a href="/" class="wordmark press" aria-label="Simon Melbye Andersen — forside">
      <span>Simon Melbye</span> <b>Andersen</b>
    </a>

    <nav class="nav" aria-label="Primær">
      {
        nav.map((n) => (
          <a href={n.href} class="press" aria-current={isCurrent(n.href) ? 'page' : undefined}>
            {n.label}
          </a>
        ))
      }
      <button class="theme-toggle press" type="button" aria-label="Skift tema">Tema</button>
    </nav>
  </div>
  <ColorBar height="3px" />
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: color-mix(in srgb, var(--paper) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(8px);
  }

  .row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
  }

  .wordmark {
    font-family: var(--font-display);
    font-size: 0.98rem;
    font-weight: 640;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .wordmark span {
    color: var(--muted);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 3vw, 1.9rem);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .nav a {
    color: var(--muted);
    transition: color var(--dur-fast) var(--ease-out);
  }
  .nav a:hover {
    color: var(--ink);
  }
  .nav a[aria-current="page"] {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 5px;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--signal);
  }

  .theme-toggle {
    padding: 0.35rem 0.6rem;
    background: none;
    border: 1px solid var(--line);
    color: var(--muted);
    font-family: inherit;
    font-size: inherit;
    letter-spacing: inherit;
    text-transform: inherit;
    cursor: pointer;
    transition:
      color var(--dur-fast) var(--ease-out),
      border-color var(--dur-fast) var(--ease-out);
  }
  .theme-toggle:hover {
    color: var(--ink);
    border-color: var(--muted);
  }
</style>
