---
import { contact, colophon } from '../data/site.js';
import ColorBar from './ColorBar.astro';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <ColorBar height="8px" />
  <div class="edge foot">
    <div class="foot-contact">
      <p class="label">Kontakt</p>
      <ul>
        {
          contact.map((c) => (
            <li>
              <a
                href={c.href}
                class="press"
                {...(c.external ? { target: '_blank', rel: 'noopener' } : {})}
              >
                <span class="label">{c.label}</span>
                <span class="val">{c.value}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="foot-end">
      <p class="mark">Simon Melbye<br />Andersen</p>
      <p class="colophon">
        {colophon.text}{' '}
        <a href={colophon.repoUrl} target="_blank" rel="noopener">Kildekode →</a>
      </p>
      <p class="label">© {year} · Bygget i Birkerød</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: var(--sect);
    background: var(--paper-2);
  }

  .foot {
    display: grid;
    gap: clamp(2.5rem, 8vw, 5rem);
    padding-block: clamp(3rem, 8vh, 5rem);
  }
  @media (min-width: 760px) {
    .foot {
      grid-template-columns: 1fr auto;
      align-items: start;
    }
  }

  .foot-contact ul {
    list-style: none;
    margin: 1.25rem 0 0;
    padding: 0;
    display: grid;
  }
  .foot-contact li + li {
    border-top: 1px solid var(--line);
  }
  .foot-contact a {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0.9rem 0;
    transition: color var(--dur-fast) var(--ease-out);
  }
  .foot-contact a:hover {
    color: var(--signal);
  }
  .foot-contact .val {
    font-size: 1.05rem;
  }

  .foot-end {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
  }
  @media (min-width: 760px) {
    .foot-end {
      justify-items: end;
      text-align: right;
    }
  }
  .mark {
    font-family: var(--font-display);
    font-weight: 640;
    font-size: clamp(1.6rem, 3vw, 2.4rem);
    line-height: 0.98;
    letter-spacing: -0.02em;
  }
  .colophon {
    max-width: 42ch;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }
  .colophon a {
    color: var(--signal);
    white-space: nowrap;
  }
</style>
